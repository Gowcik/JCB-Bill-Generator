# MSG91 Flow API Configuration for Supabase Edge Functions
# Set these secrets in your Supabase project using Supabase CLI:
# supabase secrets set MSG91_AUTHKEY=your_authkey MSG91_TEMPLATE_ID=your_template_id SMS_MODE=mock

# MSG91 Authentication Key (obtain from https://control.msg91.com)
MSG91_AUTHKEY=

# MSG91 Approved Flow Template ID (obtain from MSG91 Campaign/Flow dashboard)
MSG91_TEMPLATE_ID=

# Operating Mode: "mock" (default, free simulated testing) or "production" (calls MSG91 API)
SMS_MODE=mock

# Optional MSG91 Sender ID (6 alpha characters approved under DLT)
MSG91_SENDER_ID=

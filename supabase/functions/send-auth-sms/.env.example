# MSG91 Authentication SMS Hook Secrets for Supabase Edge Functions
# Set these secrets in your Supabase project using Supabase CLI or Dashboard:
# supabase secrets set MSG91_AUTH_KEY=your_authkey MSG91_OTP_TEMPLATE_ID=your_template_id SEND_SMS_HOOK_SECRET=your_hook_secret

# MSG91 Authentication Key (obtain from https://control.msg91.com)
MSG91_AUTH_KEY=

# MSG91 Approved OTP Template ID (DLT Registered template for Auth OTP)
MSG91_OTP_TEMPLATE_ID=

# Supabase Auth Send SMS Hook Secret (from Supabase Dashboard -> Authentication -> Hooks -> Send SMS Hook)
SEND_SMS_HOOK_SECRET=

# Optional: MSG91 Sender ID (6-character DLT approved Header)
MSG91_SENDER_ID=

# Optional: API Type - "flow" (default) or "otp"
MSG91_API_TYPE=flow

# Optional: "mock" (dry testing without using SMS credits) or empty/"production"
SMS_MODE=
